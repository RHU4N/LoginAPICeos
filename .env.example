# MongoDB Atlas connection string. Do not commit the real value in .env.
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>/ceos?retryWrites=true&w=majority

# Use a long random value in any environment shared with other people.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta HTTP da LoginAPI.
PORT=8081
