# ============================================================================
# AMBIENTE
# ============================================================================
NODE_ENV=development
PORT=8081

# ============================================================================
# MONGODB
# ============================================================================
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>/ceos?retryWrites=true&w=majority

# Nome do banco de dados (diferente para DEV/PROD)
MONGODB_DATABASE=ceos_dev

# DNS para resolução de SRV (opcional)
# MONGODB_DNS_SERVER=1.1.1.1

# ============================================================================
# SEGURANÇA - JWT
# ============================================================================
# Segredo para assinar tokens JWT (32+ caracteres em produção!)
JWT_SECRET=seu-segredo-longo-e-aleatorio-aqui-minimo-32-caracteres

# Expiração do access token
JWT_EXPIRY_ACCESS=15m

# Expiração do refresh token
JWT_EXPIRY_REFRESH=7d

# ============================================================================
# SEGURANÇA - SENHAS
# ============================================================================
# Rounds de Bcrypt (custo computacional)
BCRYPT_ROUNDS=10

# ============================================================================
# SEGURANÇA - BRUTE FORCE
# ============================================================================
# Janela de tempo para contabilizar tentativas (ms)
RATE_LIMIT_WINDOW_MS=900000

# Máximo de tentativas de login na janela
RATE_LIMIT_MAX_ATTEMPTS=5

# Duração do bloqueio após exceder tentativas (ms)
LOGIN_LOCK_DURATION_MS=1800000

# ============================================================================
# CORS
# ============================================================================
# Origem permitida para requisições CORS
CORS_ORIGIN=http://localhost:3000
# Additional exact HTTPS origins, comma-separated. No wildcards. Leave empty unless needed.
CORS_ORIGINS=

# Documentação Swagger (true localmente; false em produção)
ENABLE_SWAGGER=true

# ============================================================================
# LOGS
# ============================================================================
# Nível de log (debug, info, warn, error)
LOG_LEVEL=debug

# Mensageria: configurar com o mesmo segredo da Function App (mínimo 32 caracteres).
CEOS_SERVICE_KEY=
# Mapa controlado pelo servidor: deviceId -> ObjectId ou e-mail cadastrado.
CEOS_DEVICE_OWNERS={"wokwi-esp32-001":"usuario@example.com"}
# Render: 1. Local: vazio. App Service é detectado pelas variáveis WEBSITE_* somente leitura (um salto).
# Um valor explícito substitui a detecção; 0 desabilita confiança em proxies.
TRUST_PROXY_HOPS=
