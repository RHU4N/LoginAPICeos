{
  "info": {
    "name": "Login API - Postman Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Gera um email único para evitar conflito entre execuções",
              "pm.environment.set('emailVar', 'test+' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User created', function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Test User\",\n  \"email\": \"{{emailVar}}\",\n  \"senha\": \"Senha123!\",\n  \"confirmaSenha\": \"Senha123!\",\n  \"telefone\": \"11999999999\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful with public user and HttpOnly cookies', function () {",
              "  pm.response.to.have.status(200);",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('user');",
              "  pm.expect(json.data.user).to.have.property('id');",
              "  pm.expect(json.data).to.not.have.property('accessToken');",
              "  pm.expect(json.data).to.not.have.property('refreshToken');",
              "  pm.expect(json.data.user).to.not.have.property('senha');",
              "  pm.expect(json.data.user).to.not.have.property('senhaHash');",
              "  const cookies = pm.response.headers.all()",
              "    .filter((header) => header.key.toLowerCase() === 'set-cookie')",
              "    .map((header) => header.value);",
              "  pm.expect(cookies.length).to.be.at.least(2);",
              "  const expectCookie = (name) => {",
              "    const cookie = cookies.find((value) => value.startsWith(name + '='));",
              "    pm.expect(cookie, name + ' cookie').to.exist;",
              "    pm.expect(cookie).to.match(/httponly/i);",
              "    const secureExpected = pm.environment.get('cookieSecure');",
              "    const sameSiteExpected = pm.environment.get('cookieSameSite');",
              "    if (secureExpected !== undefined && secureExpected !== '') {",
              "      pm.expect(/;\\s*secure/i.test(cookie)).to.eql(secureExpected === 'true');",
              "    }",
              "    if (sameSiteExpected) {",
              "      pm.expect(cookie).to.match(new RegExp(';\\\\s*samesite=' + sameSiteExpected, 'i'));",
              "    }",
              "  };",
              "  expectCookie('accessToken');",
              "  expectCookie('refreshToken');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailVar}}\",\n  \"senha\": \"Senha123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    }
  ]
}
