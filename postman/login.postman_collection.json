{
  "info": {
    "name": "Login API - Postman Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health - Liveness",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health liveness 200', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('status');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Ready - MongoDB Readiness",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Readiness 200 com banco conectado', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.status).to.eql('READY');",
              "  pm.expect(json.data.database).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ready",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ready"
          ]
        }
      }
    },
    {
      "name": "Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('emailVar', 'test+' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('User created', function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Test User\",\n  \"email\": \"{{emailVar}}\",\n  \"senha\": \"Senha123!\",\n  \"confirmaSenha\": \"Senha123!\",\n  \"telefone\": \"11999999999\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
    {
      "name": "Login Invalid Password (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rejeita senha errada com HTTP 401', function () {",
              "  pm.response.to.have.status(401);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.error).to.have.property('code');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailVar}}\",\n  \"senha\": \"SenhaIncorreta999!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful with public user and HttpOnly cookies', function () {",
              "  pm.response.to.have.status(200);",
              "  var json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('user');",
              "  pm.expect(json.data.user).to.have.property('id');",
              "  pm.expect(json.data).to.not.have.property('accessToken');",
              "  pm.expect(json.data).to.not.have.property('refreshToken');",
              "  pm.expect(json.data.user).to.not.have.property('senha');",
              "  pm.expect(json.data.user).to.not.have.property('senhaHash');",
              "  const cookies = pm.response.headers.all()",
              "    .filter((header) => header.key.toLowerCase() === 'set-cookie')",
              "    .map((header) => header.value);",
              "  pm.expect(cookies.length).to.be.at.least(2);",
              "  const expectCookie = (name) => {",
              "    const cookie = cookies.find((value) => value.startsWith(name + '='));",
              "    pm.expect(cookie, name + ' cookie').to.exist;",
              "    pm.expect(cookie).to.match(/httponly/i);",
              "    if (name === 'accessToken') {",
              "      pm.environment.set('accessCookie', cookie.split(';')[0]);",
              "    }",
              "  };",
              "  expectCookie('accessToken');",
              "  expectCookie('refreshToken');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailVar}}\",\n  \"senha\": \"Senha123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Get Authenticated Profile (/auth/me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Perfil autenticado retorna usuário esperado sem senha', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.email).to.eql(pm.environment.get('emailVar'));",
              "  pm.expect(json.data).to.not.have.property('senha');",
              "  pm.expect(json.data).to.not.have.property('senhaHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{accessCookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    }
  ]
}
